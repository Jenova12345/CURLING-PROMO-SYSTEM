# Lokální env — obsahuje klíče, NEPATŘÍ do gitu (produkční hodnoty jsou v Netlify env).
# .env.example (šablona bez tajemství) se verzuje schválně.
# .env.local míří na lokální Supabase (dev) — taky se necommituje (spadá pod .env.*).
.env
.env.*
.env.local
!.env.example

# Supabase lokální stav (generuje CLI — nepatří do gitu)
supabase/.branches
supabase/.temp
supabase/.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Zálohy databáze — obsahují citlivá data (čísla účtů členů). NIKDY do gitu!
backups/

# generované/lokální artefakty dema (regeneruje scripts/build-demo-sql.sh)
demo_setup.sql
# Generuje scripts/build-upgrade-sql.sh z migrací — zdroj pravdy jsou migrace.
upgrade.sql
demo-web.zip

# jednorázový doplněk k nasazení dema (generovaný)
demo_update_*.sql

# TypeScript build mode (tsc -b) — generované, do repa nepatří
*.tsbuildinfo

# Ukázkové doklady z scripts/render-vzorky.mjs — vizuální kontrola, ne artefakt.
vzorky/

# Pomocné jednorázové skripty (suchý běh, kontroly configu) — neverzují se.
scripts/.tmp/

# Screenshoty z lokálního ověřování (nepatří do repa)
overeni-screenshoty/
