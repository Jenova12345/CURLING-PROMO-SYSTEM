# ============================================
# Supabase konfigurace pro Mladé Kameny
# ============================================
# 
# Zkopíruj tento soubor jako .env a vyplň hodnoty z tvého Supabase projektu.
# Hodnoty najdeš v Supabase dashboard → Settings → API
#
# POZOR: .env soubor NIKDY nepushuj do gitu!
# ============================================

# Supabase Project URL (z Settings → API → Project URL)
VITE_SUPABASE_URL=https://tvuj-projekt.supabase.co

# Supabase Anon/Public Key (z Settings → API → anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Project ID (část URL před .supabase.co)
VITE_SUPABASE_PROJECT_ID=tvuj-projekt
