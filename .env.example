# ============================================
# Supabase konfigurace pro Mladé Kameny
# ============================================
#
# Zkopíruj tento soubor jako .env a vyplň hodnoty z tvého Supabase projektu.
# Hodnoty najdeš v Supabase dashboard → Settings → API
#
# PRODUKČNÍ projekt (ověřeno přes Netlify env 2026-07-16): fareavttiwkamrukpfqk
#   URL: https://fareavttiwkamrukpfqk.supabase.co
# Produkční build bere hodnoty z Netlify env, ne z tohoto souboru.
# Pro lokální vývoj radši lokální Supabase / staging (viz docs/STAV.md), ať se
# netrefuješ do ostrých dat. Sem patří VÝHRADNĚ anon/publishable klíč (veřejný).
#
# POZOR: .env soubor NIKDY nepushuj do gitu! (service_role klíč sem NIKDY nepatří)
# ============================================

# Supabase Project URL (z Settings → API → Project URL)
VITE_SUPABASE_URL=https://tvuj-projekt.supabase.co

# Supabase Anon/Public Key (z Settings → API → anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Project ID (část URL před .supabase.co)
VITE_SUPABASE_PROJECT_ID=tvuj-projekt

# ============================================
# Fakturoid — fakturační provider (Etapa 3)
# ============================================
#
# NIC Z TOHOHLE NEPATŘÍ DO GITU. Tenhle soubor je ŠABLONA — hodnoty zůstávají
# prázdné. Ostré klíče žijí v Supabase secrets (Edge funkce), ne v repu a ne
# v Netlify env: `billing/` je serverová vrstva, do prohlížeče se nedostane
# a `VITE_` prefix by tu byl chyba, ne zkratka. Viz billing/README.md.
#
# Testovací účet Fakturoidu se zakládá zvlášť a `FAKTUROID_LIVE` se přepíná
# jen lokálně, v necommitovaném .env.

# Slug účtu z URL: https://app.fakturoid.cz/<slug>/…
FAKTUROID_SLUG=

# OAuth 2.0, grant client_credentials (Nastavení → API v Fakturoidu).
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=

# POVINNÁ hlavička User-Agent, jinak Fakturoid odpoví 400.
# Tvar: "NázevAplikace (kontaktní@email)"
FAKTUROID_USER_AGENT=

# Splatnost dokladu ve dnech (rozhodnutí PM).
BILLING_DUE_DAYS=14

# Režim DPH.
#   false — neplátce: řádky jdou bez vat_rate, DIČ odběratele se neposílá.
#   true  — plátce: led dostane sníženou sazbu 12 % (sportovní služby) a doklad
#           nese vat_price_mode. Klubové faktury mají ceny VČETNĚ DPH, komerční
#           BEZ DPH — rozhoduje o tom typ dokladu, ne tenhle přepínač.
#
# DIČ DODAVATELE SE ODSUD NEPOSÍLÁ. Bere si ho Fakturoid z nastavení účtu, takže
# ho stačí mít na jednom místě. Odběratelské DIČ se tahá z ARESu jako dosud.
#
# ⚠️ Přepnutí na plátce je daňové rozhodnutí, ne konfigurace: musí sedět s tím,
# co má hala nastavené ve Fakturoidu a co platí u finančního úřadu. Doklad
# vystavený ve špatném režimu se opravuje dobropisem, ne přepnutím zpátky.
#
# ⚠️ MUSÍ SE PŘEPNOUT SPOLU S ÚČTEM VE FAKTUROIDU. Když je tady `true` a účet je
# vedený jako neplátce (nebo naopak), doklad vyjde v jiném režimu, než v jakém
# ho hala vystavit chtěla. Přepíná se obojí naráz, k datu účinnosti registrace.
IS_VAT_PAYER=true

# Co se s dokladem stane po založení. Prázdné = koncept.
#   koncept  (DEFAULT) — doklad se u Fakturoidu jen založí, e-mail se NEPOSÍLÁ.
#                        Člověk si ho ve Fakturoidu prohlédne a odešle sám.
#   odeslat            — po založení se rovnou volá message.json.
#
# POZOR NA SLOVO „KONCEPT": Fakturoid API stav koncept NEZNÁ. Doklad vytvořený
# přes POST /invoices.json je plnohodnotný a UŽ MÁ ČÍSLO v ostré řadě. „Koncept"
# u nás tedy znamená „vystaveno, ale neodesláno", ne „nezávazný návrh".
#
# Překlep se NEPŘELOŽÍ na default — „odselat" je chyba, ne tiše koncept.
FAKTUROID_MODE=koncept

# Dokud je false, integrační testy se PŘESKOČÍ (nespadnou) a nikam se nevolá.
FAKTUROID_LIVE=false

# DRUHÁ POJISTKA. FAKTUROID_LIVE=true samo nestačí — sem se musí OPSAT slug účtu,
# na který integrační testy smějí psát, a musí se shodovat s FAKTUROID_SLUG.
# Důvod: kdo tu nechá produkční slug z minulého týdne a zapne LIVE, vystaví
# REÁLNÉ doklady v ostré číselné řadě. Ty nejdou smazat, jen dobropisovat.
# Opsat slug je vědomý úkon; zapomenout vypnout LIVE je nehoda.
FAKTUROID_TEST_SLUG=
